# ═══════════════════════════════════════════════════════════
#  MOCKLY — Environment Configuration Template
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mockly_db

# ── JWT Secrets (Generate strong random secrets!) ──────────
JWT_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Email / SMTP (for verification & password reset) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@mockly.dev
FROM_NAME=Mockly

# ── MySQL (Optional — for structured data) ─────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mockly_structured

# ── Google Gemini API ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
